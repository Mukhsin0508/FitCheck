# Copy to .env and fill in to enable real Higgsfield renders in dev.
# Empty = demo mode: the full loop runs against bundled renders, zero spend.
#
# ⚠️ EXPO_PUBLIC_ vars are inlined into the JS bundle — dev keys only.
# Production routes renders through a FitCheck server that holds the secret.
# Get a key at https://cloud.higgsfield.ai (KEY_ID:KEY_SECRET form).
EXPO_PUBLIC_HIGGSFIELD_CREDENTIALS=

# Optional: API host override (defaults to https://platform.higgsfield.ai).
# Keys are environment-bound — use the host that issued your key.
# EXPO_PUBLIC_HIGGSFIELD_BASE_URL=

# Optional: try-on endpoint slug override
# (default: higgsfield-ai/popcorn/auto, verified against the OpenAPI schema).
# EXPO_PUBLIC_HIGGSFIELD_TRYON_ENDPOINT=
